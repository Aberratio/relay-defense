{
  "name": "relay-defense",
  "version": "0.1.0",
  "description": "A logic tower defense game: build mazes, read the waves, pick the right counter. Deterministic engine, levels proven winnable in CI.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint . --fix",
    "typecheck": "tsc --noEmit",
    "sim": "tsx scripts/sim.ts",
    "probe": "tsx scripts/probe.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "check:wording": "tsx scripts/check-wording.ts",
    "check:language": "tsx scripts/check-language.ts",
    "tune": "tsx scripts/tune.ts",
    "solve": "tsx scripts/solve.ts",
    "smoke": "tsx scripts/smoke.ts",
    "determinism": "tsx scripts/determinism.ts",
    "sprites": "tsx scripts/sprites.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "playwright": "^1.57.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
